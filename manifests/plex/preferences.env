# Plex settings applied to Preferences.xml by the pin-preferences init container
# on every start. Key=Value, one per line. Editing this file rolls the pod.
#
# Every analysis below reads whole files through the zurg mount (TorBox/Usenet
# onto the single /volume1 HDD) - the load that saturated the disk. Keep off.
GenerateBIFBehavior=never
GenerateChapterThumbBehavior=never
GenerateIntroMarkerBehavior=never
GenerateCreditsMarkerBehavior=never
LoudnessAnalysisBehavior=never
ButlerTaskDeepMediaAnalysis=0
ButlerTaskUpgradeMediaAnalysis=0
# inotify never fires on a FUSE mount; new items arrive through a scan
FSEventLibraryUpdatesEnabled=0
# LAN for bandwidth: Tailscale + WhiteSky building network (100.64.0.0/10) and
# the pod network. lanNetworks, NOT allowedNetworks - that one skips sign-in.
lanNetworks=100.64.0.0/10,10.42.0.0/16
RelayEnabled=0
